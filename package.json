{
  "name": "system-zero",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:unit && tsc && vite build",
    "preview": "vite preview",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test": "npm run build && npm run test:e2e",
    "population:seed:pilot": "node scripts/population-db.mjs seed --count=10000",
    "population:seed": "node scripts/population-db.mjs seed --count=1000000",
    "population:status": "node scripts/population-db.mjs status",
    "population:check": "node scripts/population-db.mjs check",
    "population:benchmark": "node scripts/benchmark-population.mjs",
    "population:backup": "node scripts/population-db.mjs backup",
    "population:map:100k": "node scripts/npc-weekly.mjs seed --count=100000",
    "population:week:status": "node scripts/npc-weekly.mjs status",
    "population:week:check": "node scripts/npc-weekly.mjs check",
    "population:places:fetch": "node scripts/fetch-nyc-place-sources.mjs",
    "population:places:build": "node scripts/build-nyc-place-catalog.mjs",
    "population:places:apply": "node scripts/apply-nyc-place-catalog.mjs",
    "population:places:export": "node scripts/export-npc-place-occupancy.mjs",
    "population:browser:export": "node scripts/export-browser-npc-data.mjs"
  },
  "dependencies": {
    "three": "^0.186.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "1.9",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
