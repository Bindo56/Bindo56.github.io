# Live posts API (GET /api/live-posts on the dev server).
# Copy to .env.local and fill in the keys you have. Sources without keys stay off.
# None of these use the VITE_ prefix, so they never reach the browser bundle.

# Rolling window kept on the server (minutes) and where it is cached between restarts.
LIVE_POSTS_WINDOW_MINUTES=60
# LIVE_POSTS_CACHE_FILE=.cache/live-posts.json
# LIVE_POSTS_ENABLED=false

# Area collected continuously (default: New York City, 25 km).
# LIVE_POSTS_DEFAULT_NAME=New York City
# LIVE_POSTS_DEFAULT_LAT=40.7128
# LIVE_POSTS_DEFAULT_LON=-74.006
# LIVE_POSTS_DEFAULT_RADIUS_KM=25

# Bluesky Jetstream (free, no key). Replays this many minutes on a cold start (~120 MB per hour).
# BLUESKY_ENABLED=true
# BLUESKY_BACKFILL_MINUTES=60

# Mastodon hashtag timelines (free, no key).
# MASTODON_SERVER=mastodon.social
# MASTODON_TAGS=nyc,newyork,newyorkcity,manhattan,brooklyn,bronx,queens,statenisland

# YouTube Data API v3 key (Google Cloud console). Each location search costs 100 of 10,000 daily units.
YOUTUBE_API_KEY=
# YOUTUBE_POLL_MINUTES=20

# Flickr API key (https://www.flickr.com/services/apps/create/).
FLICKR_API_KEY=
# FLICKR_POLL_MINUTES=5

# X API v2 bearer token (paid, billed per post read).
X_BEARER_TOKEN=
# X_POLL_MINUTES=15

# Instagram Graph API (official, hashtags only): Business/Creator account + Meta app token.
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_USER_ID=
# INSTAGRAM_HASHTAGS=nyc,newyorkcity,manhattan,brooklyn
# INSTAGRAM_POLL_MINUTES=10

# Instagram location feed (unofficial): cookies from a logged-in instagram.com browser session.
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=
# INSTAGRAM_LOCATION_POLL_MINUTES=10

# Google Maps Platform key for the map calibration page (/worlds/clockwork-city/calibrate.html, dev only).
# Enable: Maps JavaScript API, Geocoding API, Places API (New), Roads API.
GOOGLE_MAPS_API_KEY=
